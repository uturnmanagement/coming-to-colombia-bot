# OpsHub Global Airfare Intelligence System — environment configuration
# Copy this file to .env and fill in the values. Never commit .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Region selection ---
# Which region pack to load from configs/<name>.yaml.
# Options: colombia | europe | southeast_asia | japan | brazil | mexico
#          | backpacker | luxury | nomad | <your own pack>
REGION_PACK=colombia

# --- Flight data source ---
# placeholder         = built-in mock data, no API key needed
# rapidapi_skyscanner = RapidAPI Skyscanner Flights & Travel API
# amadeus             = Amadeus Self-Service API
# A live provider with no key gracefully falls back to placeholder data.
FLIGHT_API_PROVIDER=rapidapi_skyscanner

# RapidAPI Skyscanner credentials.
RAPIDAPI_KEY=
RAPIDAPI_HOST=skyscanner-flights-travel-api.p.rapidapi.com

# Amadeus credentials (only if FLIGHT_API_PROVIDER=amadeus).
FLIGHT_API_KEY=
FLIGHT_API_SECRET=

# --- Operational ---
TIMEZONE=America/Bogota
RED_HEARTBEAT_MINUTES=5
RED_HEARTBEAT_DURATION_HOURS=2
YELLOW_RECHECK_MINUTES=45
GREEN_SUMMARY_HOUR=9

# --- Colombia Desk / Oak Street (Layer 1+) ---
# DRY_RUN suppresses every Oak Street dispatcher send (also recorded in
# the audit log). The scanner's direct Telegram path is *not* gated by
# DRY_RUN — use SCANNER_TELEGRAM_ENABLED for that.
DRY_RUN=false

# Layer 2 kill switch: when false, the scanner's direct Telegram sends
# are suppressed and re-routed through Oak Street's dispatcher (severity
# gate + dedupe + cooldown + audit). When true, the legacy scanner path
# operates unchanged. Default is true so an upgrade does not silently
# break an existing deployment — flip to false to migrate.
SCANNER_TELEGRAM_ENABLED=true

# Audit log destination (JSONL, append-only).
LIVE_SEND_AUDIT_LOG=logs/colombia_desk_live_sends.jsonl

# Per-deal safety cooldown between any two live sends. The heartbeat
# decay engine is the intelligent rate limiter; this is the floor.
LIVE_SEND_COOLDOWN_SECONDS=60

LOG_LEVEL=INFO
