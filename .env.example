# Coming to Colombia Bot — environment configuration
# Copy this file to .env and fill in the values. Never commit .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Region selection ---
# Which region pack to load from configs/<name>.yaml.
# Options: colombia | europe | southeast_asia | japan | brazil | mexico
#          | backpacker | luxury | nomad | <your own pack>
REGION_PACK=colombia

# --- Flight data source ---
# placeholder         = built-in mock data, no API key needed
# rapidapi_skyscanner = RapidAPI Skyscanner Flights & Travel API
# amadeus             = Amadeus Self-Service API
# A live provider with no key gracefully falls back to placeholder data.
FLIGHT_API_PROVIDER=rapidapi_skyscanner

# RapidAPI Skyscanner credentials.
RAPIDAPI_KEY=
RAPIDAPI_HOST=skyscanner-flights-travel-api.p.rapidapi.com

# Amadeus credentials (only if FLIGHT_API_PROVIDER=amadeus).
FLIGHT_API_KEY=
FLIGHT_API_SECRET=

# --- Operational ---
TIMEZONE=America/Bogota
RED_HEARTBEAT_MINUTES=5
RED_HEARTBEAT_DURATION_HOURS=2
YELLOW_RECHECK_MINUTES=45
GREEN_SUMMARY_HOUR=9

# --- Colombia Desk / Oak Street (Layer 1+) ---
# DRY_RUN suppresses every Oak Street dispatcher send (also recorded in
# the audit log). The scanner's direct Telegram path is *not* gated by
# DRY_RUN — use SCANNER_TELEGRAM_ENABLED for that.
DRY_RUN=false

# Layer 2 kill switch: when false, the scanner's direct Telegram sends
# are suppressed and re-routed through Oak Street's dispatcher (severity
# gate + dedupe + cooldown + audit). When true, the legacy scanner path
# operates unchanged. Default is true so an upgrade does not silently
# break an existing deployment — flip to false to migrate.
SCANNER_TELEGRAM_ENABLED=true

# Audit log destination (JSONL, append-only).
LIVE_SEND_AUDIT_LOG=logs/colombia_desk_live_sends.jsonl

# Per-deal safety cooldown between any two live sends. The heartbeat
# decay engine is the intelligent rate limiter; this is the floor.
LIVE_SEND_COOLDOWN_SECONDS=60

LOG_LEVEL=INFO

# --- Return-pairing windows (Layer 3, default fixed for safety) ---
# RETURN_WINDOW_MODE picks how Delta builds its return-window list.
#   fixed (default) — use the canonical 8-window list, or override via
#                     RETURN_WINDOWS_DAYS below
#   range          — generate every day from RETURN_MIN_DAYS to
#                     RETURN_MAX_DAYS inclusive, stepping by
#                     RETURN_WINDOW_STEP_DAYS
RETURN_WINDOW_MODE=fixed

# Fixed-mode override. Comma-separated positive integers. Whitespace OK.
# Leave blank to keep the canonical 4,7,10,14,21,30,42,50 list.
# RETURN_WINDOWS_DAYS=4,7,10,14,21,30,42,50

# Range-mode bounds (ignored unless RETURN_WINDOW_MODE=range).
# Defaults below produce 57 windows: every integer from 4 through 60.
RETURN_MIN_DAYS=4
RETURN_MAX_DAYS=60
RETURN_WINDOW_STEP_DAYS=1

# --- Lodging Price Intelligence (Layer 4) ---
# When false, the entire LodgingIntelService short-circuits and Echo /
# India see no signal. The brain is shared — Echo and India will plug
# into it in a later layer; Layer 4 only ships the brain.
LODGING_INTEL_ENABLED=true

# AirDNA — paid market-level data. Layer 4 ships a STUB; the live wire
# path is reserved for a later layer even when the key is set.
AIRDNA_API_KEY=

# Inside Airbnb — public listing dumps, read from a local mirror.
# Layer 4 ships a STUB; no file is read until a later layer wires it.
INSIDE_AIRBNB_LOCAL_PATH=/data/insideairbnb

# Scoring thresholds (percent below typical, AFTER season weighting).
# GREEN  weighted_pct  < 8
# YELLOW 8 <= weighted_pct < 15
# RED    weighted_pct >= 15
LODGING_YELLOW_THRESHOLD=8
LODGING_RED_THRESHOLD=15

# Season-weighted scoring on/off. When off, raw pct alone drives color.
LODGING_SEASON_WEIGHTING=true

# How far back the baseline aggregator reads from lodging_history.
LODGING_BASELINE_LOOKBACK_DAYS=90

# ---------------------------------------------------------------------------
# Layer 6 — India per-category typical prices (optional, config-driven)
# ---------------------------------------------------------------------------
# Path to a JSON object mapping accommodation category -> typical USD/night,
# overriding India's built-in Colombia-Desk defaults. Recognized keys:
#   hostel_dorm, hostel_private_room, budget_hotel, guest_house
# Example file contents: {"hostel_dorm": 18, "budget_hotel": 55}
# Unset / missing / invalid file => the built-in defaults stay in force.
# INDIA_TYPICAL_PRICES_JSON=/data/colombia_typicals.json
